{
  "manifest_version": 3,
  "name": "RoCreate — Roblox Like the Creator Hub",
  "version": "0.8.14",
  "description": "Reskins Roblox to look like the Creator Hub: clean, flat and lightweight, with game stats from Creator Exchange. Works alongside RoValra.",
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "RoCreate",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "permissions": [
    "storage",
    "alarms"
  ],
  "content_scripts": [
    {
      "matches": [
        "*://*.roblox.com/*"
      ],
      "exclude_matches": [
        "*://create.roblox.com/*",
        "*://*.devforum.roblox.com/*"
      ],
      "css": [
        "theme.css",
        "stats.css",
        "profile.css"
      ],
      "js": [
        "content.js",
        "greeting.js",
        "nav.js",
        "stats.js",
        "users.js",
        "robux.js",
        "profile.js"
      ],
      "run_at": "document_start"
    }
  ],
  "background": {
    "service_worker": "background.js"
  },
  "host_permissions": [
    "https://creatorexchange.io/*",
    "https://robloxverifieds.com/*",
    "https://accountinformation.roblox.com/*",
    "https://api.rolimons.com/*",
    "https://www.rolimons.com/*"
  ]
}
