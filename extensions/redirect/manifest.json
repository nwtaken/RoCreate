{
  "manifest_version": 3,
  "name": "RoCreate Redirect",
  "version": "1.1.0",
  "description": "Never loads roblox.com in Chrome: every Roblox link is sent straight to the RoCreate desktop app.",
  "permissions": ["declarativeNetRequest", "storage"],
  "host_permissions": ["*://*.roblox.com/*", "http://127.0.0.1:47653/*"],
  "background": { "service_worker": "background.js" },
  "action": {
    "default_title": "RoCreate Redirect: click to turn on/off",
    "default_icon": { "16": "icons/icon-16.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png" }
  },
  "icons": { "16": "icons/icon-16.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png" },
  "web_accessible_resources": [
    { "resources": ["go.html", "go.js"], "matches": ["*://*.roblox.com/*"] }
  ]
}
